<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VeteranSoldiersVersion>1.0.1</VeteranSoldiersVersion>
    <IncludeTestHarness Condition="'$(IncludeTestHarness)' == ''">false</IncludeTestHarness>
    <PathMap>$(MSBuildThisFileDirectory)=/src</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release' and '$(IncludeTestHarness)' != 'true'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release' and '$(IncludeTestHarness)' != 'true'">false</DebugSymbols>
    <OutputPath Condition="'$(IncludeTestHarness)' == 'true'">bin\$(Configuration)\qa\</OutputPath>
    <IntermediateOutputPath Condition="'$(IncludeTestHarness)' == 'true'">obj\$(Configuration)\qa\</IntermediateOutputPath>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Diplomacy is Not an Option</GamePath>
    <GameManaged>$(GamePath)\Diplomacy is Not an Option_Data\Managed</GameManaged>
    <BepInExCore>$(MSBuildThisFileDirectory)tools\bepinex-ecs\BepInEx\core</BepInExCore>
  </PropertyGroup>
</Project>
